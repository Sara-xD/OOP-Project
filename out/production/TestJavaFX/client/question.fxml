<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<VBox prefWidth="910.0" spacing="10.0" stylesheets="@../../resources/exam.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.quesController">
    <CheckBox fx:id="selectBox" prefHeight="40.0" prefWidth="42.0" styleClass="check-box"/>
    <Label fx:id="question" alignment="CENTER" contentDisplay="CENTER" maxHeight="Infinity" prefHeight="64.0" prefWidth="880.0" styleClass="question_label" stylesheets="@../../resources/exam.css" wrapText="true">
    <font>
         <Font name="Poppins Medium" size="18.0" />
      </font></Label>
   <Label fx:id="opt1" alignment="CENTER" maxHeight="Infinity" prefHeight="40.0" prefWidth="880.0" styleClass="option_label" stylesheets="@../../resources/exam.css" wrapText="true">
      <font>
         <Font name="Poppins Medium" size="18.0" />
      </font>
   </Label>
   <Label fx:id="opt2" alignment="CENTER" maxHeight="Infinity" prefHeight="40.0" prefWidth="1256.0" styleClass="option_label" wrapText="true">
      <font>
         <Font name="Poppins Medium" size="18.0" />
      </font>
   </Label>
   <Label fx:id="opt3" alignment="CENTER" maxHeight="Infinity" prefHeight="40.0" prefWidth="1256.0" styleClass="option_label" wrapText="true">
      <font>
         <Font name="Poppins Medium" size="18.0" />
      </font>
   </Label>
   <Label fx:id="opt4" alignment="CENTER" maxHeight="Infinity" prefHeight="40.0" prefWidth="1256.0" styleClass="option_label" stylesheets="@../../resources/exam.css" wrapText="true">
      <font>
         <Font name="Poppins Medium" size="18.0" />
      </font>
   </Label>
   <Label fx:id="explanation" alignment="CENTER" maxHeight="Infinity" prefHeight="100.0" prefWidth="1215.0" styleClass="default_label" stylesheets="@../../resources/exam.css" wrapText="true">
       <graphic>
           <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
               <image>
                   <Image url="@../../resources/exp.png" />
               </image>
           </ImageView>
       </graphic>
       <font>
         <Font name="Poppins Medium" size="18.0" />
      </font>
   </Label>
   <Label fx:id="answer" alignment="CENTER" maxHeight="Infinity" prefHeight="27.0" prefWidth="181.0" styleClass="Label3" stylesheets="@../../resources/exam.css" wrapText="true">
      <font>
         <Font name="Poppins Medium" size="18.0" />
      </font>
   </Label>
   <Button mnemonicParsing="false" onAction="#edit" prefHeight="29.0" prefWidth="75.0" styleClass="btn" stylesheets="@../../resources/exam.css" text="Edit" />
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" />
   </padding>
</VBox>
