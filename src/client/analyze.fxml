<AnchorPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.analyzeController">
      <Label layoutX="481.0" layoutY="29.0" text="Analyze Result" textFill="WHITE" styleClass="title_label">
         <font>
            <Font name="Poppins ExtraBold" size="42.0" />
         </font>
      </Label>
      <AnchorPane fx:id="colored_card" layoutX="351.0" layoutY="130.0" prefHeight="80.0" prefWidth="265.0" styleClass="colored_card" stylesheets="@../../resources/exam.css">
            <Label stylesheets="@../../resources/dashboardT.css" text="Students at exams" textFill="BLACK" AnchorPane.leftAnchor="45.0" AnchorPane.topAnchor="15.0">
               <font>
                  <Font name="Poppins Medium" size="19.0" />
               </font>
            </Label>
            <Label fx:id="stnum" layoutX="125.0" layoutY="40.0" text="Label" textFill="black">
               <font>
                  <Font name="Poppins SemiBold" size="30.0" />
               </font>
               <padding>
                  <Insets bottom="10.0" />
               </padding>
            </Label>
      </AnchorPane>
      <AnchorPane fx:id="uncolored_card" layoutX="688.0" layoutY="132.0" prefHeight="80.0" prefWidth="265.0" styleClass="colored_card" stylesheets="@../../resources/exam.css">
            <Label stylesheets="@../../resources/dashboardT.css" text="Running exams" AnchorPane.leftAnchor="80.0" AnchorPane.topAnchor="15.0">
               <font>
                  <Font name="Poppins Medium" size="19.0" />
               </font>
            </Label>
            <Label fx:id="examnum" layoutX="125.0" layoutY="38.0" stylesheets="@../../resources/dashboardT.css" text="Label">
               <font>
                  <Font name="Poppins SemiBold" size="30.0" />
               </font>
            </Label>
         <padding>
            <Insets bottom="10.0" />
         </padding>
      </AnchorPane>
      <GridPane layoutX="24.0" layoutY="255.0" prefHeight="398.0" prefWidth="1250.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints maxHeight="191.26504516601562" minHeight="10.0" prefHeight="52.198760986328125" vgrow="SOMETIMES" />
          <RowConstraints maxHeight="350.168701171875" minHeight="10.0" prefHeight="346.3012390136719" vgrow="SOMETIMES" />
        </rowConstraints>
            <TableView fx:id="table" prefHeight="366.0" prefWidth="1250.0" styleClass="table-view" stylesheets="@../../resources/exam.css" GridPane.rowIndex="1">
              <columns>
                <TableColumn fx:id="exam_name" prefWidth="250.0" text="Exam Name" />
                <TableColumn fx:id="subject" prefWidth="250.0" text="Subject" />
                  <TableColumn fx:id="name" prefWidth="250.0" text="Student's Name" />
                  <TableColumn fx:id="total" prefWidth="160.0" text="Total Marks" />
                  <TableColumn fx:id="marks" prefWidth="160.0" text="Obtained Marks" />
                  <TableColumn fx:id="rank" prefWidth="160.0" text="Rank" />
              </columns>
            </TableView>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                  <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@../../resources/search.png" />
                  </ImageView>
                  <TextField fx:id="search_box" alignment="CENTER" prefHeight="40.0" prefWidth="350.0" promptText="Search for an Exam" styleClass="search"/>
                  <Button mnemonicParsing="false" onAction="#search" prefHeight="33.0" prefWidth="92.0" styleClass="btn" stylesheets="@../../resources/exam.css" text="Search" />
            </HBox>
      </GridPane>
      <Button layoutX="576.0" layoutY="663.0" mnemonicParsing="false" onAction="#back" prefHeight="31.0" prefWidth="169.0" styleClass="btn" stylesheets="@../../resources/exam.css" text="Back">
         <font>
            <Font name="Poppins SemiBold" size="19.0" />
         </font>
      </Button>
</AnchorPane>
