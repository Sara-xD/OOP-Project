<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.forumController">
    <children>
        <HBox prefHeight="720.0" prefWidth="1280.0">
            <children>
                <VBox prefHeight="720.0" prefWidth="283.0" style="-fx-background-color: #ffcf71;">
                    <children>
                        <Button mnemonicParsing="false" onAction="#post" prefHeight="53.0" prefWidth="168.0" styleClass="button-forum" stylesheets="@../../resources/exam.css" text="Post">
                            <VBox.margin>
                                <Insets left="25.0" top="150.0" />
                            </VBox.margin>
                            <font>
                                <Font name="Poppins SemiBold" size="26.0" />
                            </font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#back" prefHeight="56.0" prefWidth="168.0" styleClass="button-forum" stylesheets="@../../resources/exam.css" text="Back">
                            <VBox.margin>
                                <Insets left="25.0" top="25.0" />
                            </VBox.margin>
                            <font>
                                <Font name="Poppins SemiBold" size="26.0" />
                            </font>
                        </Button>
                    </children>
                </VBox>
                <HBox prefHeight="720.0" prefWidth="1134.0">
                    <children>
                        <ScrollPane prefHeight="700.0" prefWidth="1120.0" styleClass="box" stylesheets="@../../resources/exam.css">
                            <HBox.margin>
                                <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
                            </HBox.margin>
                            <content>
                                <VBox fx:id="forumCards" prefHeight="593.0" prefWidth="940.0" spacing="10.0" />
                            </content>
                        </ScrollPane>
                    </children>
                </HBox>
            </children>
        </HBox>
    </children>
</AnchorPane>
