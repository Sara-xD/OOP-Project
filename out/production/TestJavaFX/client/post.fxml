<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="200.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.postController">
    <children>
        <TextArea fx:id="topic_box" layoutX="13.0" layoutY="13.0" prefHeight="68.0" prefWidth="572.0" promptText="Write discussion topic" styleClass="post-des-topic" stylesheets="@../../resources/exam.css">
            <font>
                <Font name="Poppins SemiBold" size="21.0" />
            </font>
        </TextArea>
        <TextField fx:id="ques_box" layoutX="14.0" layoutY="92.0" prefHeight="58.0" prefWidth="572.0" promptText="Write your Question" styleClass="post-ques" stylesheets="@../../resources/exam.css">
            <font>
                <Font name="Poppins Regular" size="21.0" />
            </font>
        </TextField>
        <Button fx:id="submit" layoutX="245.0" layoutY="158.0" mnemonicParsing="false" onAction="#submit" prefHeight="29.0" prefWidth="92.0" styleClass="button-post-submit" stylesheets="@../../resources/exam.css" text="Submit">
            <font>
                <Font name="Poppins SemiBold" size="14.0" />
            </font>
        </Button>
    </children>
</AnchorPane>
